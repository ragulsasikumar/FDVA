
# Experiment: EDA - Data Inspection and Analysis

# Step 1: Import required libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Step 2: Create a sample dataset
data = {
    'Name': ['Arun', 'Bala', 'Charan', 'Divya', 'Ezhil',
             'Farhan', 'Gokul', 'Hari'],
    'Age': [20, 21, 19, 22, 20, 23, 21, 19],
    'Department': ['AIML', 'CSE', 'AIML', 'IT', 'CSE',
                   'AIML', 'IT', 'CSE'],
    'Marks': [85, 90, 78, 92, 88, 76, 95, 82],
    'Attendance': [90, 85, 80, 95, 88, 75, 92, 84]
}

df = pd.DataFrame(data)

# Step 3: Display the dataset
print("ORIGINAL DATASET")
print(df)

# Step 4: Inspect the first and last rows
print("\nFIRST FIVE ROWS")
print(df.head())

print("\nLAST FIVE ROWS")
print(df.tail())

# Step 5: Display dataset shape and columns
print("\nDATASET SHAPE")
print(df.shape)

print("\nCOLUMN NAMES")
print(df.columns.tolist())

# Step 6: Display dataset information
print("\nDATASET INFORMATION")
df.info()

# Step 7: Check data types
print("\nDATA TYPES")
print(df.dtypes)

# Step 8: Check missing and duplicate values
print("\nMISSING VALUES")
print(df.isnull().sum())

print("\nDUPLICATE ROWS")
print(df.duplicated().sum())

# Step 9: Generate statistical summary
print("\nSTATISTICAL SUMMARY")
print(df.describe())

# Step 10: Analyze marks
print("\nMARKS ANALYSIS")
print("Average Marks:", df['Marks'].mean())
print("Highest Marks:", df['Marks'].max())
print("Lowest Marks:", df['Marks'].min())
print("Median Marks:", df['Marks'].median())
print("Standard Deviation:", round(df['Marks'].std(), 2))

# Step 11: Analyze department-wise performance
print("\nDEPARTMENT-WISE AVERAGE MARKS")
print(df.groupby('Department')['Marks'].mean())

# Step 12: Sort students by marks
print("\nSTUDENTS SORTED BY MARKS")
print(df.sort_values(by='Marks', ascending=False))

# Step 13: Display correlation
print("\nCORRELATION MATRIX")
print(df[['Age', 'Marks', 'Attendance']].corr())

# Step 14: Visualize marks using a bar chart
plt.figure(figsize=(8, 5))
plt.bar(df['Name'], df['Marks'])
plt.xlabel('Students')
plt.ylabel('Marks')
plt.title('Student Marks Analysis')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# Step 15: Visualize attendance using a histogram
plt.figure(figsize=(8, 5))
plt.hist(df['Attendance'], bins=5, edgecolor='black')
plt.xlabel('Attendance')
plt.ylabel('Number of Students')
plt.title('Attendance Distribution')
plt.tight_layout()
plt.show()

# Step 16: Visualize correlation using a heatmap
correlation = df[['Age', 'Marks', 'Attendance']].corr()

plt.figure(figsize=(6, 4))
plt.imshow(correlation, cmap='coolwarm', vmin=-1, vmax=1)
plt.colorbar(label='Correlation')
plt.xticks(range(len(correlation.columns)),
           correlation.columns, rotation=45)
plt.yticks(range(len(correlation.columns)),
           correlation.columns)

for i in range(len(correlation.columns)):
    for j in range(len(correlation.columns)):
        plt.text(j, i, f'{correlation.iloc[i, j]:.2f}',
                 ha='center', va='center')

plt.title('Correlation Heatmap')
plt.tight_layout()
plt.show()

# Step 17: Final result
print("\nEDA DATA INSPECTION AND ANALYSIS COMPLETED")
